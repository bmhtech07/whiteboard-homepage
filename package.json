{
  "name": "whiteboard-tab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A dark, persistent whiteboard that replaces Chrome's new tab page.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate && node scripts/build-extension.mjs",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "^4.6.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
